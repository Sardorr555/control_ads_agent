# SWIPIES Traffic Attribution & Analytics Engine (Track 3)
# Configuration Template - DO NOT COMMIT REAL SECRETS

# Ingestion Service (Isolated Port 5001)
TRACKER_HOST=127.0.0.1
TRACKER_PORT=5001
ATTRIBUTION_DB_PATH=./data/attribution_events.db

# Anonymization & Salt (Rotated or static per deployment policy, min 32 chars)
ATTRIBUTION_SALT=generate_strong_random_salt_min_32_chars_for_production

# MySQL Read-Only Analytics User (Limited strictly to SELECT on v_attribution_payments)
ANALYTICS_RO_USER=analytics_ro
ANALYTICS_RO_PASSWORD=generate_strong_random_analytics_password
ANALYTICS_RO_HOST=127.0.0.1
ANALYTICS_RO_PORT=3306
ANALYTICS_RO_DB=swipies_db

# Retention Policies
RAW_RETENTION_DAYS=30
AGGREGATE_RETENTION_DAYS=365
