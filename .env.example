# SWIPIES Traffic Attribution & Analytics Engine (Track 3)
# Configuration Template - DO NOT COMMIT REAL SECRETS

# Ingestion Service (Isolated Port 5001)
TRACKER_HOST=127.0.0.1
TRACKER_PORT=5001
ATTRIBUTION_DB_PATH=./data/attribution_events.db

# Anonymization & Salt (Rotated or static per deployment policy, min 32 chars)
ATTRIBUTION_SALT=generate_strong_random_salt_min_32_chars_for_production

# MySQL Read-Only Analytics User (Limited strictly to SELECT on v_attribution_payments)
ANALYTICS_RO_USER=analytics_ro
ANALYTICS_RO_PASSWORD=generate_strong_random_analytics_password
ANALYTICS_RO_HOST=127.0.0.1
ANALYTICS_RO_PORT=3306
ANALYTICS_RO_DB=swipies_db

# Retention Policies
RAW_RETENTION_DAYS=30
AGGREGATE_RETENTION_DAYS=365

# Google Ads API Credentials (Track 4: Search Automation)
# Leave blank to keep client running in safe Zero-Key Mock/Dry-Run mode
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=123-456-7890
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Twitter / X Ads API Credentials (Track 5: Global Tech Lead Generation)
# Leave blank to keep client running in safe Zero-Key Mock/Dry-Run mode
TWITTER_ADS_ACCOUNT_ID=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
TWITTER_BEARER_TOKEN=

# Meta Ads (Instagram / Facebook) API Credentials (Track 6: Central Asia LeadGen)
# Graph API v21.0 - Leave blank to keep running in safe Zero-Key Mock/Dry-Run mode
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_1234567890
META_APP_ID=
META_APP_SECRET=

# Yandex Direct API Credentials (Track 7: ??? & Local UZS Accounting)
# Direct API v5 - Leave blank to keep running in safe Zero-Key Mock/Dry-Run mode
YANDEX_DIRECT_TOKEN=
YANDEX_DIRECT_CLIENT_LOGIN=
YANDEX_DIRECT_USE_SANDBOX=false
